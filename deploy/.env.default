# =============================================================================
# Production image version
# =============================================================================

# Used only by published/prod mode. Ignored by local-build, which reads the
# source VERSION file instead. GitHub Actions replaces this placeholder in
# release artifacts.
PROJECT_VERSION=__PROJECT_VERSION__

# =============================================================================
# Security
# =============================================================================

JWT_SECRET=replace-with-at-least-32-random-characters

# =============================================================================
# Database
# =============================================================================

DB_DRIVER=sqlite
DB_DSN=/runtime/app-data/media-library.db

# =============================================================================
# Host runtime / permissions
# =============================================================================

RUNTIME_DIR=./runtime

MEDIA_UID=1000
MEDIA_GID=1000

DOCKER_GID=998

# =============================================================================
# Docker networking
# =============================================================================

DOCKER_NETWORK_NAME=media-library
DOCKER_NETWORK_EXTERNAL=false

# =============================================================================
# Host ports
# =============================================================================

# The web service always publishes WEB_PORT for plain HTTP access — this is the
# only entry point the stack needs when HTTPS is off. WEB_PORT is the HOST
# mapping (IP:port or bare port) and WEB_INTERNAL_PORT is the port nginx listens
# on INSIDE the web container. Set WEB_INTERNAL_PORT to a non-default value when
# your own reverse proxy forwards to the container, so it does not collide with
# other services on the common port 8080 (the optional gateway and the API's
# internal port are unaffected).
WEB_PORT=8080
WEB_INTERNAL_PORT=8080

# HTTPS is served by an optional Caddy gateway (compose profile "https").
# Enable it when you want HTTPS/Let's Encrypt by setting COMPOSE_PROFILES=https
# and restarting the stack. Protocol enablement, public DNS and Let's Encrypt
# email are then configured in the administrator UI (HTTP starts enabled,
# HTTPS starts off). GATEWAY_HTTP_PORT/HTTPS_PORT are the gateway's host ports;
# they must not collide with WEB_PORT.
GATEWAY_HTTP_PORT=8081
GATEWAY_HTTPS_PORT=443

# Empty by default = HTTP-only stack without the gateway. Set to "https" to
# run the Caddy gateway alongside the web service (required for HTTPS).
COMPOSE_PROFILES=

# =============================================================================
# Container paths
# =============================================================================

# Mount your media folders into the api container manually (e.g. in
# deploy/compose.yaml) and add them as libraries in the admin UI. Libraries
# reference explicit absolute paths inside the container.
APP_LOG_FILE=/runtime/app-config/logs/app.log
CADDY_DATA_DIR=/runtime/caddy-data
GATEWAY_CONFIG_FILE=/runtime/app-config/gateway/Caddyfile
THUMBNAIL_DIR=/runtime/thumbnails

# =============================================================================
# Frontend
# =============================================================================

VITE_API_URL=/api/v1
