# Stage 1 – web assets + Capacitor sync (lightweight Node image)
FROM node:22-alpine AS web
WORKDIR /src
COPY web/ .
RUN npm ci --prefer-offline 2>/dev/null || npm install
RUN npm run build
RUN npx cap sync android

# Stage 2 – Android APK (JDK + Android SDK, no Node)
FROM eclipse-temurin:21-jdk-jammy AS builder

ENV ANDROID_HOME=/opt/android-sdk
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends unzip && \
    rm -rf /var/lib/apt/lists/*
RUN mkdir -p "${ANDROID_HOME}/cmdline-tools" && \
    curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
      -o /tmp/cmdline-tools.zip && \
    unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline-tools && \
    mv /tmp/cmdline-tools/cmdline-tools "${ANDROID_HOME}/cmdline-tools/latest" && \
    rm -rf /tmp/cmdline-tools /tmp/cmdline-tools.zip && \
    yes | sdkmanager --licenses >/dev/null 2>&1 && \
    sdkmanager "build-tools;35.0.0" "platforms;android-35"

ARG MEDIA_UID=1000
ARG MEDIA_GID=1000
RUN groupadd -g "${MEDIA_GID}" builder && \
    useradd -u "${MEDIA_UID}" -g "${MEDIA_GID}" -m builder && \
    chown -R builder:builder "${ANDROID_HOME}"
USER builder
WORKDIR /src

COPY --chown=builder:builder --from=web /src/android android
COPY --chown=builder:builder --from=web /src/node_modules/@capacitor node_modules/@capacitor
COPY --chown=builder:builder deploy/android-entrypoint.sh /src/android-entrypoint.sh
ENTRYPOINT ["/bin/sh", "/src/android-entrypoint.sh"]
