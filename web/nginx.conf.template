map $http_x_forwarded_proto $media_forwarded_proto {
  default $http_x_forwarded_proto;
  "" $scheme;
}

server {
  listen ${WEB_INTERNAL_PORT};
  server_name _;
  root /usr/share/nginx/html;
  resolver 127.0.0.11 ipv6=off valid=10s;
  set $media_api http://api:8080;

  location /api/ {
    proxy_pass $media_api;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $media_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location = /swagger {
    proxy_pass $media_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $media_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /swagger/ {
    proxy_pass $media_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $media_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # Hashed bundles never change under one name, so they may be cached forever.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # index.html (and the SPA fallback to it) must be revalidated on every load;
  # without an explicit header browsers and the Android WebView cache it
  # heuristically and keep pointing at the previous release's bundles.
  location / {
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
