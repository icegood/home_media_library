# Secrets (local only)
deploy/.env
.github-token

# Runtime data (single bind mount)
runtime/
build/

# Local tooling / editors
.continue/
.idea/
.vscode/

# Host Android/Capacitor build output (only when web/android/ is present)
web/android/.gradle/
web/android/app/build/

# Generated / installed dependencies
web/node_modules/
web/coverage/
web/src/generated-version.ts

# Playwright e2e artifacts (videos, traces, reports)
web/test-output/

# Vite/vitest local caches
.vite/
web/*.tsbuildinfo

# Release signing credentials (never commit)
web/android/keystore.properties
